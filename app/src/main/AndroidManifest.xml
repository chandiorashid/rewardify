<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Rewardify"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rewardify"
        tools:targetApi="34">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Rewardify">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for Supabase email confirmation. Must match the
                 scheme/host configured in data/Supabase.kt and be allow-listed
                 in the Supabase dashboard (Authentication -> URL Configuration
                 -> Redirect URLs). singleTask ensures taps route to
                 onNewIntent instead of creating a second activity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.milesolutions.rewardify"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
