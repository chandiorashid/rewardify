<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Rewardify"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rewardify"
        tools:targetApi="36">
        <!-- AdMob app id. Sample id below — replace with the real id from the
             AdMob dashboard before release (keep in sync with AdsConfig.APP_ID). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Rewardify">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for Supabase email confirmation. Must match the
                 scheme/host configured in data/Supabase.kt and be allow-listed
                 in the Supabase dashboard (Authentication -> URL Configuration
                 -> Redirect URLs). singleTask ensures taps route to
                 onNewIntent instead of creating a second activity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.milesolutions.rewardify"
                    android:host="auth-callback" />
            </intent-filter>
            <!-- Deep link for referral invites:
                 com.milesolutions.rewardify://referral?code=ABC123
                 Tapping one opens the app and pre-fills the code on signup. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.milesolutions.rewardify"
                    android:host="referral" />
            </intent-filter>
        </activity>
    </application>

</manifest>
